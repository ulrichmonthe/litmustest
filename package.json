{
  "name": "litmustest-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b packages/cli",
    "test": "vitest run",
    "docs:schemas": "node scripts/gen-schema-docs.ts",
    "validate": "node packages/cli/src/main.ts validate",
    "example:seed": "node examples/support-agent/src/generate_traces.ts && node examples/support-agent/src/seed_evals.ts",
    "docs:tokens": "node scripts/gen-tokens-css.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
